{
  "manifest_version": 3,
  "name": "Eva Browser Bridge",
  "short_name": "Eva",
  "version": "1.0.0",
  "description": "Lets Eva, your desktop assistant, read and work with the page you have open -- only when you ask her.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Eva Browser Bridge" },
  "minimum_chrome_version": "116"
}
